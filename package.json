{
  "name": "morrow-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply morrow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply morrow-db --remote",
    "test": "node scripts/deploy.test.mjs && node scripts/backup.test.mjs"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.31.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
